<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    android:backgroundTint="@color/white"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        >

        <!-- Title -->
        <TextView
            android:id="@+id/tvBazarName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="বিয়ের বাজার"
            android:textColor="#8BC34A"
            android:textSize="22sp"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteBazar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <!-- Date & Time Row -->
        <LinearLayout
            android:id="@+id/infoLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/btnDeleteBazar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBazarName"
            >

            <TextView
                android:id="@+id/tvBazarDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 25-05-2024"
                android:textColor="#757575"
                android:textSize="12sp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="#BDBDBD"
                />

            <TextView
                android:id="@+id/tvBazarTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ 10:30 AM"
                android:textColor="#757575"
                android:textSize="12sp"
                />
        </LinearLayout>

        <!-- Delete Button (Top Right) -->
        <ImageButton
            android:id="@+id/btnDeleteBazar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_delete_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FF5252"
            />

        <!--  (Inside Card) -->
        <LinearLayout

            android:layout_width="50dp"
            android:layout_height="26dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_plus"
            android:elevation="6dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoLayout"
            >

            <ImageView
                android:id="@+id/btnAddMore"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/outline_add_circle_24"
                app:tint="#FFFFFF"
                />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>